<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.smarthome.controller.MainViewController"
            stylesheets="@styles.css"
            prefHeight="760.0" prefWidth="1180.0" styleClass="main-container">

    <!-- BARRA SUPERIOR -->
    <top>
        <VBox styleClass="header-bar">
            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <padding>
                    <Insets top="10.0" right="20.0" bottom="10.0" left="20.0"/>
                </padding>

                <!-- Titulo -->
                <VBox spacing="2.0">
                    <Label text="Sistema de Hogar Inteligente" styleClass="app-title"/>
                    <Label text="Panel de Gestión y Automatización" styleClass="app-subtitle"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Indicadores de Estado -->
                <HBox spacing="8.0" alignment="CENTER">
                    <Label fx:id="lblSecurityBadge" text="DESARMADO" styleClass="badge-security"/>
                    <Label fx:id="lblEnergyStrategyBadge" text="Modo Eco" styleClass="badge-energy"/>
                    <Label fx:id="lblActiveDevices" text="0 / 0 Activos" styleClass="badge-neutral"/>
                    <Label fx:id="lblPowerConsumption" text="0.0 W" styleClass="badge-power"/>
                </HBox>

                <Separator orientation="VERTICAL"/>

                <!-- Botones Deshacer / Rehacer -->
                <HBox spacing="6.0" alignment="CENTER">
                    <Button fx:id="btnUndo" text="Deshacer" onAction="#onUndoClicked" styleClass="btn-action"/>
                    <Button fx:id="btnRedo" text="Rehacer" onAction="#onRedoClicked" styleClass="btn-action"/>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- CONTENIDO PRINCIPAL -->
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="custom-tabpane">

            <!-- PESTAÑA 1: DISPOSITIVOS -->
            <Tab text="Dispositivos">
                <VBox spacing="12.0">
                    <padding>
                        <Insets top="12.0" right="16.0" bottom="12.0" left="16.0"/>
                    </padding>

                    <!-- Filtro y control por habitacion -->
                    <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="toolbar-panel">
                        <padding>
                            <Insets top="8.0" right="12.0" bottom="8.0" left="12.0"/>
                        </padding>
                        <Label text="Habitación:" styleClass="label-bold"/>
                        <ComboBox fx:id="cmbRoomFilter" prefWidth="190.0"/>

                        <Separator orientation="VERTICAL"/>

                        <Label text="Control de la estancia:" styleClass="label-bold"/>
                        <Button fx:id="btnRoomTurnOn" text="Encender Todos" onAction="#onTurnRoomOn" styleClass="btn-success"/>
                        <Button fx:id="btnRoomTurnOff" text="Apagar Todos" onAction="#onTurnRoomOff" styleClass="btn-danger"/>
                    </HBox>

                    <!-- Tarjetas de dispositivos -->
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="transparent-scroll">
                        <FlowPane fx:id="devicesFlowPane" hgap="12.0" vgap="12.0" prefWrapLength="1100.0">
                            <padding>
                                <Insets top="4.0" right="4.0" bottom="4.0" left="4.0"/>
                            </padding>
                        </FlowPane>
                    </ScrollPane>

                    <!-- Formulario para agregar dispositivo -->
                    <TitledPane text="Registrar Nuevo Dispositivo" expanded="false">
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <padding>
                                <Insets top="8.0" right="10.0" bottom="8.0" left="10.0"/>
                            </padding>
                            <Label text="Tipo:"/>
                            <ComboBox fx:id="cmbNewDeviceType" prefWidth="180.0"/>
                            <Label text="Nombre:"/>
                            <TextField fx:id="txtNewDeviceName" promptText="Ej. Lámpara de noche" prefWidth="180.0"/>
                            <Label text="Ubicación:"/>
                            <ComboBox fx:id="cmbNewDeviceRoom" prefWidth="160.0"/>
                            <Button fx:id="btnCreateDevice" text="Guardar Dispositivo" onAction="#onCreateDevice" styleClass="btn-primary"/>
                        </HBox>
                    </TitledPane>
                </VBox>
            </Tab>

            <!-- PESTAÑA 2: ESCENAS -->
            <Tab text="Escenas y Rutinas">
                <SplitPane dividerPositions="0.55" VBox.vgrow="ALWAYS">
                    <!-- Escenas -->
                    <VBox spacing="10.0">
                        <padding>
                            <Insets top="12.0" right="14.0" bottom="12.0" left="14.0"/>
                        </padding>
                        <Label text="Escenas Configuradas" styleClass="section-header"/>
                        <Label text="Permiten ejecutar varias acciones automáticas con un solo clic." styleClass="label-hint"/>
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="transparent-scroll">
                            <VBox fx:id="scenesContainer" spacing="8.0">
                                <padding>
                                    <Insets top="4.0" right="4.0" bottom="4.0" left="4.0"/>
                                </padding>
                            </VBox>
                        </ScrollPane>
                    </VBox>

                    <!-- Historial de Comandos -->
                    <VBox spacing="10.0">
                        <padding>
                            <Insets top="12.0" right="14.0" bottom="12.0" left="14.0"/>
                        </padding>
                        <Label text="Historial de Acciones" styleClass="section-header"/>
                        <Label text="Registro de órdenes realizadas con soporte para Deshacer/Rehacer." styleClass="label-hint"/>
                        <ListView fx:id="lstCommandHistory" VBox.vgrow="ALWAYS" styleClass="custom-list"/>
                    </VBox>
                </SplitPane>
            </Tab>

            <!-- PESTAÑA 3: ENERGÍA -->
            <Tab text="Control de Energía">
                <VBox spacing="16.0">
                    <padding>
                        <Insets top="16.0" right="20.0" bottom="16.0" left="20.0"/>
                    </padding>

                    <Label text="Modos de Consumo Eléctrico" styleClass="section-header"/>

                    <!-- Opciones de Estrategia -->
                    <HBox spacing="25.0" styleClass="toolbar-panel">
                        <padding>
                            <Insets top="12.0" right="16.0" bottom="12.0" left="16.0"/>
                        </padding>
                        <RadioButton fx:id="rbEco" text="Modo Ahorro (Ecológico)" styleClass="radio-custom"/>
                        <RadioButton fx:id="rbComfort" text="Modo Confort Normal" styleClass="radio-custom"/>
                        <RadioButton fx:id="rbNight" text="Modo Noche / Salida" styleClass="radio-custom"/>
                    </HBox>

                    <!-- Detalles del modo -->
                    <VBox spacing="8.0" styleClass="info-panel">
                        <padding>
                            <Insets top="12.0" right="14.0" bottom="12.0" left="14.0"/>
                        </padding>
                        <Label text="Descripción del modo seleccionado:" styleClass="label-bold"/>
                        <Label fx:id="lblStrategyDesc" text="Detalles del algoritmo..." wrapText="true" styleClass="label-body"/>
                        <Label fx:id="lblSavingsPercent" text="Ahorro estimado" styleClass="badge-power"/>
                    </VBox>

                    <!-- Consumo por habitaciones -->
                    <VBox spacing="8.0">
                        <Label text="Consumo actual por habitación:" styleClass="label-bold"/>
                        <VBox fx:id="roomConsumptionVBox" spacing="6.0"/>
                    </VBox>
                </VBox>
            </Tab>

            <!-- PESTAÑA 4: SEGURIDAD -->
            <Tab text="Seguridad y Alarma">
                <VBox spacing="16.0">
                    <padding>
                        <Insets top="16.0" right="20.0" bottom="16.0" left="20.0"/>
                    </padding>

                    <Label text="Panel de Seguridad del Hogar" styleClass="section-header"/>

                    <!-- Estado actual -->
                    <VBox spacing="6.0" styleClass="info-panel">
                        <padding>
                            <Insets top="12.0" right="16.0" bottom="12.0" left="16.0"/>
                        </padding>
                        <Label text="Estado del Sistema:" styleClass="label-bold"/>
                        <Label fx:id="lblSecStateName" text="DESARMADO"/>
                        <Label fx:id="lblSecStateDesc" text="Descripción..."/>
                    </VBox>

                    <!-- Controles -->
                    <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="toolbar-panel">
                        <padding>
                            <Insets top="12.0" right="16.0" bottom="12.0" left="16.0"/>
                        </padding>
                        <Button fx:id="btnArmHome" text="Armar (En Casa)" onAction="#onArmHome" styleClass="btn-warning"/>
                        <Button fx:id="btnArmAway" text="Armar (Fuera)" onAction="#onArmAway" styleClass="btn-primary"/>

                        <Separator orientation="VERTICAL"/>

                        <Label text="Clave PIN:" styleClass="label-bold"/>
                        <PasswordField fx:id="txtPin" promptText="1234" prefWidth="90.0"/>
                        <Button fx:id="btnDisarm" text="Desarmar" onAction="#onDisarm" styleClass="btn-success"/>
                    </HBox>

                    <!-- Pruebas de sensores -->
                    <VBox spacing="10.0" styleClass="info-panel">
                        <padding>
                            <Insets top="12.0" right="16.0" bottom="12.0" left="16.0"/>
                        </padding>
                        <Label text="Pruebas de Sensores:" styleClass="label-bold"/>
                        <Label text="Pruebe la reacción automática del sistema activando las señales de prueba:" styleClass="label-hint"/>

                        <HBox spacing="12.0">
                            <Button fx:id="btnSimulateMotion" text="Simular Movimiento (Patio)" onAction="#onSimulateMotion" styleClass="btn-action"/>
                            <Button fx:id="btnSimulateSmoke" text="Simular Sensor de Humo (Cocina)" onAction="#onSimulateSmoke" styleClass="btn-danger"/>
                        </HBox>
                    </VBox>
                </VBox>
            </Tab>

            <!-- PESTAÑA 5: EVENTOS -->
            <Tab text="Registro de Eventos">
                <VBox spacing="10.0">
                    <padding>
                        <Insets top="12.0" right="16.0" bottom="12.0" left="16.0"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label text="Eventos del Sistema en Tiempo Real" styleClass="section-header"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Limpiar Registro" onAction="#onClearEvents" styleClass="btn-action"/>
                    </HBox>

                    <Label text="Historial cronológico de cambios de estado, alertas y acciones ejecutadas." styleClass="label-hint"/>
                    <ListView fx:id="lstEvents" VBox.vgrow="ALWAYS" styleClass="custom-list"/>
                </VBox>
            </Tab>

        </TabPane>
    </center>

</BorderPane>
